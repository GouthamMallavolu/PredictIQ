# Dockerfile for Kafka Consumer Service
# Runs continuously to process incoming stock data from Kafka

FROM python:3.10-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY kafka_pipeline/ ./kafka_pipeline/
COPY scripts/ ./scripts/
COPY models/ ./models/
COPY pipeline/ ./pipeline/
COPY evaluation/ ./evaluation/

# Create logs directory
RUN mkdir -p logs

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Health check (check if consumer process is running)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pgrep -f "run_consumer_service.py" || exit 1

# Run the consumer service
CMD ["python", "scripts/run_consumer_service.py"]

